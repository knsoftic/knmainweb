# KN Softic website - production settings
#
# Copy this file to `.env.production` in the same folder. These three values are all the site
# needs; nothing here is secret, but the file still stays out of the repository because it is
# specific to one server.
#
# IMPORTANT: these values are built into the site by `npm run build`. After changing anything
# here you must build again and restart the app — a restart on its own changes nothing.

# Where the visitor's browser sends requests. Must be the public HTTPS address, and must match
# CORS_ORIGIN in the API's .env, or the browser will block every request and the site will look
# empty.
NEXT_PUBLIC_API_URL=https://api.knsoftic.com/api

# Where the server itself fetches data while rendering pages.
#
# The public address always works, so start with it:
API_INTERNAL_URL=https://api.knsoftic.com/api
#
# Optional speed-up: if the API runs on this same machine on a port you control, pointing at it
# directly skips the web server and HTTPS. Only use this if the port is really fixed - on shared
# hosting the panel often assigns the port itself, and a wrong value here means pages render
# without their content. Test it over SSH first:
#     curl -I http://127.0.0.1:5000/api/settings
# A 200 means it is safe to use:
# API_INTERNAL_URL=http://127.0.0.1:5000/api

# The site's own address, without a trailing slash. Used for canonical links, the sitemap and
# share previews, so a wrong value here shows up in Google.
NEXT_PUBLIC_SITE_URL=https://knsoftic.com
