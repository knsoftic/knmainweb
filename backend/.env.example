# KN Softic API - production settings
#
# Copy this file to `.env` in the same folder and fill in the four values marked CHANGE THIS.
# This file is a template and is safe to keep in the repository; `.env` itself must never be
# committed and should be readable only by you:  chmod 600 .env
#
# The API refuses to start if the database settings, CORS_ORIGIN or JWT_SECRET are missing,
# and says which one is wrong.

# ----------------------------------------------------------------- Server
# The port the API listens on. If your hosting panel assigns the port itself
# (Hostinger's Node.js app manager does), delete this line so the panel decides.
PORT=5000

# Must be "production" on the live server: it enables secure cookies and hides error details.
NODE_ENV=production

# ---------------------------------------------------------------- Database
# Use the details from hPanel -> Databases. On Hostinger the host is usually localhost.
DB_HOST=localhost
DB_PORT=3306
DB_USER=CHANGE THIS
DB_PASSWORD=CHANGE THIS
DB_NAME=CHANGE THIS

# -------------------------------------------------------- Sign-in security
# Two long random strings. Generate each with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Anyone holding JWT_SECRET can sign in as an administrator, so treat it like a password.
# Keep the SAME value when you move servers, or everyone signed in is logged out.
JWT_SECRET=CHANGE THIS
JWT_REFRESH_SECRET=CHANGE THIS

# ------------------------------------------------------------------- Access
# Which website addresses may call this API. The www version of each is allowed automatically.
# Separate several with commas, no spaces:  https://knsoftic.com,https://shop.knsoftic.com
CORS_ORIGIN=https://knsoftic.com

# The API runs behind the panel's web server, so it must trust one proxy hop to see the real
# visitor address. Without this, the protection against password guessing counts every visitor
# as the same person. 1 is also the default if the line is missing.
TRUST_PROXY=1

# ------------------------------------------------------------------ Uploads
# Absolute path to the folder holding images uploaded in the admin panel.
# Find yours by running `pwd` in the project folder over SSH, then add /public/uploads.
# Leave this line out and it defaults to <project>/public/uploads.
# This folder must survive deployments and be included in your backups.
UPLOAD_DIR=/home/CHANGE THIS/domains/knsoftic.com/knsoftic/public/uploads
